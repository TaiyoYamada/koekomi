# ===== Colab 起動用の設定（直書き禁止。Colab のシークレット or os.environ で渡す）=====
# 公開トンネルは Cloudflare Quick Tunnel（無料・鍵不要・複数台OK）で固定。

# GAS の Web アプリ URL（サーバーレジストリ）
GAS_URL=https://script.google.com/macros/s/XXXX/exec

# イベントの合言葉。フロントの VITE_EVENT_TOKEN と同じ文字列。
EVENT_TOKEN=

# 管理者トークン。/cleanup（全員分を消す）専用。フロントには配らない。
ADMIN_TOKEN=

# フロントの公開オリジン（写真の取得元）と、CORS 許可オリジン（カンマ区切り）。
# 未設定なら CORS_ORIGINS は FRONTEND_ORIGIN で埋められる。
FRONTEND_ORIGIN=https://koekomi.taiyoyamada.com
CORS_ORIGINS=https://koekomi.taiyoyamada.com,https://koekomi.vercel.app

# このColabの識別情報（台ごとに変える）
SERVER_ID=colab-1
SERVER_COLOR=red
SERVER_LABEL=赤サーバー

# 1台で受け入れる人数（1〜2人を想定）
CAPACITY=2

# 任意
PORT=8000
HEARTBEAT_SEC=30
