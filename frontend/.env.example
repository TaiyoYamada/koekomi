# ===== フロントエンド設定（コピーして .env を作成）=====

# サーバー名簿（GAS）の Web アプリ URL。今日の3つのURLを取りに行く先。
# 例: https://script.google.com/macros/s/XXXXXXXX/exec
VITE_GAS_URL=

# イベントの合言葉。バックエンドの全エンドポイントに付ける。
# Colab 側の EVENT_TOKEN と同じ文字列にすること。
#
# バンドルに載るので完全な秘密ではないが、「アプリのURLを踏んだだけの
# 第三者」と「イベント参加者」を分けるには十分。空にすると認証なしで動くが、
# 本番では必ず設定すること（子どもの声を扱うため）。
VITE_EVENT_TOKEN=

# サーバー名簿の lastSeen が「新しい」と判定する許容秒数（任意・既定300）。
# これより古い heartbeat のサーバーは候補から外す。
VITE_SERVER_FRESH_SECONDS=300
